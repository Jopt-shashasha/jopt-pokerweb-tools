APP_ORIGIN=https://portal.example.invalid
PORT=8788
# Production only. 127.0.0.1 behind Caddy on a VPS; 0.0.0.0 inside a container (Fly).
HOST=127.0.0.1
PORTAL_DATA_DIR=/absolute/private/path/portal-data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_DOMAINS=japanopenpoker.com,huntersite.jp
INITIAL_ADMIN_EMAIL=xiao.h@japanopenpoker.com
# Comma-separated HTTPS RSS/Atom URLs. No browser-supplied feed URLs are accepted.
NEWS_FEED_URLS=
# Slack (Bot Token). Without it the portal only previews messages.
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_URL=https://jopthq.slack.com
# Backups (scripts/backup.ts). Use a directory on a different disk/host from PORTAL_DATA_DIR.
BACKUP_DIR=

{
  "name": "jopt-gyomu-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/local.ts --local",
    "start": "node --env-file-if-exists=.env --import tsx src/local.ts",
    "build:sites": "node scripts/build-sites.mjs",
    "check": "tsc --noEmit",
    "check:client": "node --check public/app.js",
    "test": "tsx --test tests/*.test.ts",
    "test:sites": "npm run build:sites && node --import tsx --test tests/worker.sites.ts",
    "import:drop": "tsx scripts/import-drop.ts",
    "import:aifact": "tsx scripts/import-aifact.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.18",
    "markdown-it": "^15.0.3",
    "oauth4webapi": "^3.8.8",
    "playwright-core": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
